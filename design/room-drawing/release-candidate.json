  "consumers": [
    {
      "module": "apps/game/hosted/board-v2-host.mjs",
      "reads": "For each room: --bm-scene-<room>-back and its layers (the scene art bundle), the four-berth ward's --board-v2-film-scenes-hospital-ward-four-* (the films art bundle), and in a Blackout --board-v2-motion-<room>-dark or --board-v2-film-lighting-hospital-ward-four-dark."
    },
    {
      "module": "apps/game/hosted/scene-board.mjs",
      "reads": "The comic board's scene mode: --bm-scene-<zone>-back and its layers."
    },
    {
      "module": "apps/game/hosted/board-v2-scene.mjs",
      "reads": "The private-talk capsule: --board-v2-art-capsule-<back|door-0..3|busy|dark> (the board-v2 art bundle); its badge stays."
    },
    {
      "module": "apps/game/hosted/board-v2-films.mjs",
      "reads": "The Captain's films: jailDoorSvg() and airlockSvg() from board-v2-drawing/captain-fx.mjs; the Hospital's: droneSvg(), berthScreenSvg() and lampSvg() from board-v2-drawing/medical-fx.mjs. Under this release they come from the ports in apps/game/hosted/room-drawing/, with the same exports and geometry."
    }
  ],
  "dispatch": "Exact release only. These pictures belong to the art release that registers them (after design-0.7.0); every earlier release keeps its bundles byte for byte. A board draws the new rooms only under that release, as the crew's exact-release dispatch does, and draws the new crew and the new rooms together.",
  "notReplaced": [
    {
      "what": "The films' other art: the Captain's console inset, plates, cover, glove, click, suction, debris, emergency light, exterior view and plaque; the medical vitals inset, tags, scan line, hologram and pulse; the clone card; the Blackout's sparks, impact and markers; the shield",
      "why": "no room behind them: insets, tags and effects drawn over any room, in the board's comic hand; the crew in every film is the crew release's, drawn live"
    },
    {
      "what": "--board-v2-art-capsule-badge",
      "why": "a tag, not the room"
    },
    {
      "what": "--bm-scene-hospital-back, --bm-scene-hospital-bed-left and --bm-scene-hospital-bed-right",
      "why": "the two-bed sick bay of the scene art, which the board no longer draws: board-v2 draws the four-berth ward (HOSPITAL-4-2026-10-18), redrawn here"
    },
    {
      "what": "--board-v2-art-ward-<7|8|9>-back, --board-v2-art-ward-berth-h<n> and --board-v2-motion-hospital-ward-<7|8|9>-dark",
      "why": "the roster-sized ward of the earlier ruleset (design-0.4.0); the four-berth successor is redrawn"
    }
  ],
  "unverified": [
    "No phone has drawn these: frame time, decode time and memory on a low-end Android phone and an iPhone are Frontend's to measure.",
    "The scene art, motion art and films art bundles are not rebuilt here; their sizes after registration are Integration's to report."
  ]
