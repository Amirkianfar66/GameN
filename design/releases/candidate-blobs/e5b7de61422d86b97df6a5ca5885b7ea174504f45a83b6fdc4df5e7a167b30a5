.pregame-overlay{position:fixed;inset:0;z-index:100000;overflow:hidden;background:#07090F;color:#F4EBDD;isolation:isolate}
.pregame-picture-root,.pregame-picture{position:absolute;inset:0;overflow:hidden}
.pregame-picture-root>svg,.pregame-picture>svg{display:block;width:100%;height:100%}
.pregame-captions{position:absolute;inset:0;pointer-events:none}
.pregame-caption{position:absolute;margin:0;padding:.32em .6em .36em;max-width:calc(100vw - 32px);box-sizing:border-box;transform-origin:0 0;white-space:pre-line;font:700 .8125rem/1.15 "Arial Narrow","Helvetica Neue",Arial,sans-serif;letter-spacing:.04em;text-transform:uppercase;color:#1B140C;background:linear-gradient(180deg,#F3E3BE,#E2CC9C);border:2px solid #0B0E15;box-shadow:3px 4px 0 #0008}
.pregame-skip{position:absolute;right:max(12px,env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom));min-height:44px;min-width:44px;padding:10px 16px;font:700 1rem/1.2 system-ui,sans-serif;color:#F4EBDD;background:#0B0E15;border:2px solid #F4EBDD;border-radius:4px;cursor:pointer}
.pregame-skip:focus-visible{outline:3px solid #F2C14E;outline-offset:3px}
.pregame-screen-reader{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.planet-display-settings{margin-block:12px}.planet-display-settings label{display:flex;align-items:center;gap:8px;margin-block:8px}.planet-display-settings input,.planet-display-settings select{min-height:44px;min-width:44px}
