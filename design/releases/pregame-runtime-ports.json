      "approvedHookPatches": [
        {
          "before": "export function litFigure(",
          "after": "// Runtime boundary: preserve the reviewed placement/light calculation while a retained consumer\n// mounts the frozen crew drawing once and applies crewPoseFrame to that same figure. The ordinary\n// reference renderer is unchanged when no collector is installed. The scope is synchronous.\nlet retainedFigures = null;\nexport function withRetainedFigures(collect, draw) {\n  const previous = retainedFigures;\n  retainedFigures = collect;\n  try { return draw(); } finally { retainedFigures = previous; }\n}\n\nexport function litFigure("
        },
        {
          "before": "  const inner = dressedFigureSvg(member, sk, { outfit, prefix: `${id}-f`, inline: true, motion: life });",
          "after": "  const inner = retainedFigures\n    ? retainedFigures({ id, member, sk, outfit, prefix: `${id}-f`, motion: life })\n    : dressedFigureSvg(member, sk, { outfit, prefix: `${id}-f`, inline: true, motion: life });"
        }
      ]
    },
