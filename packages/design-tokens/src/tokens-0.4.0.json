  "usageConstraints": [
    "Faction accents require authorized private knowledge or an explicit reveal.",
    "Public tokens remain neutral and identical across roles.",
    "Use ink on paper/amber; primary or secondary text on dark panels.",
    "Confirm contrast in final compositing; these tokens alone do not certify accessibility.",
    "Motion durations never determine server phase deadlines or outcomes.",
    "Amber is interaction focus and the public active turn. It never stands for a faction, danger, an attack or a result.",
    "Public status is told apart by outline and label. Injured and Eliminated are never red.",
    "Each location is printed in its own color family, over the ink and paper every location shares. A family belongs to a room: it never stands for a team, a role, a player or a state.",
    "Halftone and hatch never sit behind text smaller than the heading size.",
    "Everything private to a seat, including whether it has an action, stays inside the private sheet. The public layer of every phone looks the same.",
    "Role artwork loads as one uniform bundle on every phone, whatever the role.",
    "A playing piece is a character its player chose before roles were dealt. It never depends on a role, and no role, team or private choice may change it.",
    "A role's device is drawn only inside that seat's own private sheet. No piece, cue, location or shared display shows one.",
    "A player's name is text the player typed: untrusted, bounded in length, and always beside the seat number."
  ],
  "motionPolicy": {
    "specification": "docs/design/motion-direction.md",
    "durationStatus": "proposed_targets_not_measured",
    "levels": [
      "interaction",
      "game_event",
      "phase_or_finale"
    ],
    "reducedMotion": "direct state update or short fade; no spatial travel, shake, zoom or moving trails",
    "publicSecretActionCue": false,
    "blocksActiveControls": false,
    "mutatesGameplayState": false,
    "storyboards": "docs/design/motion-storyboards.md",
    "beatStatus": "proposed_split_of_existing_totals_not_measured",
    "overlaysInterceptInput": false,
    "queuesPlayback": false,
    "loops": false,
    "comicBoardBeats": "pieceMove, roleCardTurn, roleDeal and roomPick are the times the owner-approved comic board plays. pieceMove and roleCardTurn have a cue contract (design/contract/motion-cues.json); roleDeal and roomPick have none yet, because nothing in today's markup carries a hand or a room that can be picked. None is measured on a device.",
    "ambient": "undecided (DSN-D16): the reference stylesheets hold no motion that repeats, and motionPolicy.loops stays false as in the pinned 0.2.0 file"
  },
