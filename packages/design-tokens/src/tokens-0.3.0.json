{
  "version": "0.3.0",
  "status": "proposal_for_evaluation",
  "supersedes": "0.2.0",
  "compatibility": "Additive. Every 0.2.0 key keeps its name, shape and value; 0.3.0 only adds keys.",
  "color": {
    "canvas": "#10141C",
    "panel": "#202837",
    "paper": "#F4EBDD",
    "ink": "#151923",
    "textPrimary": "#F4EBDD",
    "textSecondary": "#B9C4D3",
    "publicToken": "#C6CDD4",
    "interactiveAccent": "#F1B84B",
    "focusRing": "#FFD36D",
    "factionPrivateOrRevealed": {
      "blue": "#70AFFF",
