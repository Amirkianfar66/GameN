    "headingPx": 24,
    "displayPx": 36,
    "bodyLineHeight": 1.5,
    "headingLineHeight": 1.15,
    "letteringFamily": "Arial Narrow, Helvetica Neue, Arial, sans-serif",
    "letteringWeight": 800,
    "letteringTrackingEm": 0.06,
    "timerNumeric": "tabular-nums",
    "privateRoleNameMaxPx": 24,
    "tableTimerPx": 56,
    "tableHeadingPx": 32
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radiusPx": {
    "control": 8,
    "panel": 12,
    "card": 10,
    "chip": 999
  },
  "strokePx": {
    "control": 2,
    "focus": 3,
    "illustration": 3,
    "inkFine": 2,
    "inkBold": 4,
    "panelBorder": 4,
    "selection": 3
  },
  "interaction": {
    "minimumTargetCssPx": 44,
    "cardArtAspectRatio": "5:7",
    "breakpointsCssPx": {
      "expandedPlayerLayout": 600,
      "wideTableLayout": 960,
      "tableRosterBesideBoard": 1280
    },
    "dragRequired": false,
    "breakpointUnit": "em: each value divided by 16, so a layout answers to the reader's text size"
  },
  "motionMs": {
    "selection": 120,
    "cardTransition": 220,
    "publicMove": 450,
    "comicBeatMaximum": 900,
    "reducedMotionFade": 80,
    "registrationStamp": 120,
    "publicImpact": 320,
    "roundTransition": 700
  },
  "motionEasing": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "impact": "cubic-bezier(0.55, 0, 1, 0.45)",
    "settle": "cubic-bezier(0.16, 0.84, 0.3, 1)",
    "snap": "cubic-bezier(0.2, 1.3, 0.4, 1)",
    "sweep": "cubic-bezier(0.65, 0, 0.35, 1)",
    "linear": "linear"
  },
  "motionBeatsMs": {
    "selection": {
      "opening": 0,
      "accent": 70,
      "settle": 50
    },
    "cardTransition": {
      "opening": 60,
      "accent": 100,
      "settle": 60
    },
    "registrationStamp": {
      "opening": 30,
      "accent": 50,
      "settle": 40
    },
    "publicMove": {
      "opening": 110,
      "accent": 220,
      "settle": 120
    },
    "roundTransition": {
      "opening": 180,
      "accent": 220,
      "settle": 300
    },
    "comicBeatMaximum": {
      "opening": 240,
      "accent": 260,
      "settle": 400
    }
  },
  "comic": {
    "inkShadowOffsetPx": 4,
    "inkShadowOffsetLiftedPx": 7,
    "selectionLiftPx": 3,
    "panelGutterPx": 12,
    "stampRotationDeg": -4,
    "halftone": {
      "pitchPx": 6,
      "angleDeg": 45,
      "dotRadiusPx": {
        "fine": 1,
        "medium": 1.7,
        "heavy": 2.4
      },
      "neverBehindTextSmallerThanPx": 24
    },
    "hatch": {
      "pitchPx": 8,
      "strokePx": 2,
      "angleDeg": 45
    }
  },
  "component": {
