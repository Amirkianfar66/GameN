{
  "name": "@mothership/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "tsc --build && node --test \"test/**/*.test.mjs\"",
    "check:exclusion": "tsc --build && node scripts/check-production-exclusion.mjs",
    "dev:fixture": "tsc --build && node dev/serve.mjs",
    "dev:capture": "tsc --build && node dev/capture-evidence.mjs",
    "dev:capture:shot": "tsc --build && node dev/capture-shot-flow.mjs",
    "dev:capture:cues": "tsc --build && node dev/capture-cues.mjs"
  },
  "dependencies": {
    "@mothership/contracts": "0.1.0",
    "@mothership/presentation": "0.1.0",
    "@mothership/design-tokens": "0.1.0"
  }
}
